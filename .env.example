# TinyIntent Configuration Example
# Copy this file to .env and customize for your environment

# Environment (development, staging, production)
TINYINTENT_ENVIRONMENT=development

# Security Configuration
TINYINTENT_SECRET=your-secret-key-here-minimum-32-characters
TINYINTENT_ALLOW_DEV_LOCAL=1
TINYINTENT_EXECUTION_ENABLED=0

# Server Configuration
TINYINTENT_BIND=127.0.0.1
TINYINTENT_PORT=8787
TINYINTENT_LOG_LEVEL=info
TINYINTENT_WORKERS=1
TINYINTENT_RELOAD=0
TINYINTENT_DEBUG=0

# Rate Limiting
TINYINTENT_RATE_LIMIT_SESSION=60
TINYINTENT_RATE_LIMIT_GLOBAL=500
TINYINTENT_RATE_LIMIT_WINDOW=60

# Helper Configuration
HELPER_RATE_LIMIT=10
HELPER_RATE_LIMIT_WINDOW=60
HELPER_DEFAULT_TIMEOUT=30
HELPER_MAX_MEMORY_MB=256
HELPER_MAX_CPU_TIME=10
HELPER_MAX_OUTPUT_SIZE=1048576

# Database Configuration
DB_EPISODES_DIR=data/episodes
DB_BACKUP_DIR=backups
DB_MAX_EPISODES_FILE_SIZE=104857600

# Logging Configuration
LOG_AUDIT_MAX_SIZE_MB=50
LOG_AUDIT_RETENTION_DAYS=90
LOG_STRUCTURED_LOGGING=1

# Model Configuration
MODEL_OLLAMA_URL=http://localhost:11434
MODEL_DEFAULT_MODEL=llama2
MODEL_ROUTER_MODEL_PATH=

# Exchange API Configuration (if using exchange helpers)
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSPHRASE=