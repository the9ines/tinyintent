# TinyIntent Configuration
# Copy this file to .env and uncomment/modify settings as needed
# 
# M9.1: Final Polish & Release Prep - Safe defaults for production

# ============================================================================
# SECURITY & EXECUTION CONTROL
# ============================================================================

# Required: Cryptographic secret for API authentication
# Generate with: openssl rand -hex 32
# TINYINTENT_SECRET=your_secret_here

# Execution control (CRITICAL SECURITY SETTING)
# Set to 1 to enable actual helper execution in production
# Default: 0 (preview mode only for safety)
EXECUTION_ENABLED=0

# Emergency kill switch flag file location
# If this file exists, all execution is disabled
# EMERGENCY_FLAG_PATH=./data/emergency.flag

# ============================================================================
# API & NETWORKING
# ============================================================================

# Bridge API server configuration
# BRIDGE_HOST=localhost
# BRIDGE_PORT=8787

# Ollama LLM service configuration
OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=30

# Generation timeout (seconds)
GEN_TIMEOUT_S=20

# Request timeout for external services (seconds)
# REQUEST_TIMEOUT_S=30

# ============================================================================
# RATE LIMITING & ABUSE PROTECTION
# ============================================================================

# Per-session rate limits (requests per minute)
# SESSION_RATE_LIMIT=60

# Global rate limits (requests per minute)
# GLOBAL_RATE_LIMIT=500

# Helper execution rate limits (executions per minute)
# HELPER_RATE_LIMIT=10

# Rate limit window duration (seconds)
# RATE_LIMIT_WINDOW=60

# ============================================================================
# ROUTER & MODEL CONFIGURATION
# ============================================================================

# Router model configuration
# ROUTER_MODEL_PATH=./router/SmallIntent.mlmodel
# ROUTER_CONFIDENCE_THRESHOLD=0.7
# ROUTER_FALLBACK_ROUTE=gen

# Training and evaluation thresholds
# ROUTER_MIN_ACCURACY=0.85
# ROUTER_MIN_TRAINING_SAMPLES=100

# Model promotion criteria
# AUTO_PROMOTE_MODELS=false
# PROMOTION_ACCURACY_THRESHOLD=0.90
# PROMOTION_LATENCY_THRESHOLD_MS=500

# ============================================================================
# HELPER FRAMEWORK
# ============================================================================

# Helper execution timeouts (seconds)
# HELPER_EXECUTION_TIMEOUT=30
# HELPER_HEALTH_CHECK_TIMEOUT=10

# Helper capability restrictions
# HELPER_NETWORK_DISABLED=0
# HELPER_FILESYSTEM_RESTRICTED=0

# Helper sandbox configuration
# HELPER_AUDIT_LOG_PATH=./data/helpers/audit.log
# HELPER_EXECUTION_LOG_LEVEL=INFO

# ============================================================================
# CIRCUIT BREAKER & RELIABILITY
# ============================================================================

# Circuit breaker thresholds
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
# CIRCUIT_BREAKER_REQUEST_VOLUME_THRESHOLD=10

# Retry configuration
# MAX_RETRIES=3
# RETRY_BACKOFF_MS=1000
# RETRY_MAX_BACKOFF_MS=10000

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Audit logging configuration
# AUDIT_LOG_PATH=./bridge/logs/audit.log
# AUDIT_LOG_ROTATION=true
# AUDIT_LOG_MAX_SIZE_MB=100
# AUDIT_LOG_BACKUP_COUNT=5

# Episode logging for training data
# EPISODE_LOG_PATH=./data/episodes/events.db
# EPISODE_RETENTION_DAYS=90

# Performance metrics
# METRICS_ENABLED=true
# METRICS_EXPORT_INTERVAL=60

# ============================================================================
# DATA & STORAGE
# ============================================================================

# Data directory paths
# DATA_DIR=./data
# EPISODES_DIR=./data/episodes
# MODELS_DIR=./router
# HELPERS_DIR=./helpers

# Database configuration
# DB_PATH=./data/episodes/events.db
# DB_POOL_SIZE=5
# DB_TIMEOUT=30

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Development mode (enables additional logging, relaxed timeouts)
# DEV_MODE=false

# Allow development bypass for local testing
# ALLOW_DEV_LOCAL=0

# Test mode configuration
# TEST_MODE=false
# TEST_SKIP_AUTH=false
# TEST_MOCK_OLLAMA=false

# Smoke test configuration
# SMOKE_MODE=false
# SMOKE_SKIP_SLOW_TESTS=false

# ============================================================================
# HELPER-SPECIFIC CONFIGURATION
# ============================================================================

# Bot Guard (trading helper) configuration
# EXCHANGE_API_KEY=your_api_key
# EXCHANGE_API_SECRET=your_api_secret
# EXCHANGE_PASSPHRASE=your_passphrase
# EXCHANGE_BASE_URL=https://api.sandbox.pro.coinbase.com
# EXCHANGE_MODE=sandbox

# SSH Operations helper configuration
# SSH_HOST=your_server_host
# SSH_USER=your_ssh_user
# SSH_KEY_PATH=~/.ssh/id_rsa

# Log Tailer helper configuration
# DEFAULT_LOG_PATH=/var/log/system.log
# MAX_LOG_LINES=1000

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Concurrency limits
# MAX_CONCURRENT_REQUESTS=10
# MAX_CONCURRENT_HELPERS=3
# MAX_CONCURRENT_GENERATIONS=2

# Memory limits
# MAX_MEMORY_MB=1024
# MAX_EPISODE_CACHE_SIZE=10000

# Network configuration
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# SSL/TLS configuration (for production deployments)
# SSL_CERT_PATH=
# SSL_KEY_PATH=
# SSL_CA_PATH=

# ============================================================================
# NOTES
# ============================================================================
#
# 1. SECURITY: Always keep EXECUTION_ENABLED=0 in production until you've
#    thoroughly tested helpers in preview mode.
#
# 2. SECRETS: Never commit real secrets to version control. Use environment
#    variables or secure secret management.
#
# 3. HELPERS: Each helper may require specific environment variables.
#    Check helper documentation for requirements.
#
# 4. MONITORING: Enable audit logging and metrics in production for
#    security and performance monitoring.
#
# 5. RATE LIMITS: Adjust rate limits based on your usage patterns and
#    system capacity.
#