# TinyIntent Configuration for iPhone Shortcut Testing
TINYINTENT_ENVIRONMENT=development
TINYINTENT_SECRET=test-secret-for-shortcut-development-min32chars
TINYINTENT_ALLOW_DEV_LOCAL=1
TINYINTENT_EXECUTION_ENABLED=1
TINYINTENT_BIND=0.0.0.0
TINYINTENT_PORT=8787
TINYINTENT_LOG_LEVEL=info
TINYINTENT_DEBUG=1

# iPhone Shortcut Configuration
SHORTCUT_TOKEN=iphone-shortcut-secure-token-123
SHORTCUT_MAX_LEN=800

# Rate Limiting (relaxed for testing)
TINYINTENT_RATE_LIMIT_SESSION=60
TINYINTENT_RATE_LIMIT_GLOBAL=500

# Helper Configuration
HELPER_RATE_LIMIT=10
HELPER_DEFAULT_TIMEOUT=30

# Model Configuration
MODEL_OLLAMA_URL=http://localhost:11434
MODEL_DEFAULT_MODEL=llama2

# Exchange API (dummy for testing)
NODE_ENV=development
EXCHANGE_API_KEY=dummy
EXCHANGE_SECRET=dummy
EXCHANGE_PASSPHRASE=dummy