#!/usr/bin/env bash

# TinyIntent Neuro Agent - Routes prompts to appropriate backends
# Usage: neuro_agent [--dry-run] [--json] [--quiet] [--help] [text...]

set -euo pipefail
IFS=$'\n\t'

# Environment variables with defaults
TINYINTENT_BIN="${TINYINTENT_BIN:-/Users/oberfelder/projects/smallintent/router/tinyintent}"
OLLAMA_MODEL="${OLLAMA_MODEL:-qwen2.5:32b-instruct-q4_K_M}"
LOCAL_MODEL_PREF="${LOCAL_MODEL_PREF:-auto}"

# Global flags
DRY_RUN=false
JSON_MODE=false
QUIET_MODE=false

# Function to show help
show_help() {
    cat <<EOF
TinyIntent Neuro Agent - Local-first routing agent

Usage: neuro_agent [OPTIONS] [text...]

Options:
  --dry-run    Show execution plan without running commands
  --json       Output structured JSON logs to stdout
  --quiet      Suppress non-essential output
  --help, -h   Show this help message

Routes:
  local_only       Ollama only (privacy-first, no network calls)
                   Example: "summarize this code locally"
  
  plan_then_local  Local refinement → local execution with larger model
                   Example: "brainstorm steps then execute with 70B model"

Environment Variables:
  ROUTE            Override automatic route classification
  LOCAL_MODEL_PREF Model size preference: 8b|32b|70b|auto (default: auto)
                   auto: ≤300 tokens→8B, 301-1200→32B, >1200→70B
                   Keywords bump to 70B: theorem, proof, chain-of-thought, etc.
  OLLAMA_MODEL     Primary Ollama model (default: qwen2.5:32b-instruct-q4_K_M)
  TINYINTENT_BIN   Path to tinyintent binary
EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --json)
            JSON_MODE=true
            shift
            ;;
        --quiet)
            QUIET_MODE=true
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

# Function to log to stderr (human-readable)
log() {
    if [[ "$QUIET_MODE" != "true" ]]; then
        echo "$@" >&2
    fi
}

# Function to emit JSON log to stdout
emit_json_log() {
    local route="$1"
    local model_name="$2"
    local model_size="$3"
    local tokens_in="$4"
    local tokens_out="$5"
    local duration_ms="$6"
    local privacy_mode="$7"
    local reclassified="$8"
    local phase="${9:-}"
    local selection_reason="${10:-}"
    
    # Remote context from environment (set by bridge)
    local remote_addr="${REMOTE_ADDR:-local}"
    local tailscale="${TAILSCALE:-false}"
    local body_size_kb="${BODY_SIZE_KB:-0}"
    
    local timestamp
    if date -u +"%Y-%m-%dT%H:%M:%S.%3NZ" 2>/dev/null | grep -q '%3N'; then
        # %3N not supported, use milliseconds approximation
        timestamp=$(date -u +"%Y-%m-%dT%H:%M:%S")
        local ms=$(($(date +%s%N) % 1000000000 / 1000000))
        timestamp="${timestamp}.$(printf "%03d" $ms)Z"
    else
        timestamp=$(date -u +"%Y-%m-%dT%H:%M:%S.%3NZ")
    fi
    
    local json_log="{"
    json_log+="\"timestamp\":\"$timestamp\","
    json_log+="\"route\":\"$route\","
    json_log+="\"model_name\":\"$model_name\","
    json_log+="\"model_size\":\"$model_size\","
    json_log+="\"tokens_in\":$tokens_in,"
    json_log+="\"tokens_out\":$tokens_out,"
    json_log+="\"duration_ms\":$duration_ms,"
    json_log+="\"privacy_mode\":\"$privacy_mode\","
    json_log+="\"reclassified\":$reclassified,"
    json_log+="\"source\":\"neuro_agent\","
    json_log+="\"dry_run\":$(if [[ "$DRY_RUN" == "true" ]]; then echo "true"; else echo "false"; fi)"
    
    if [[ -n "$phase" ]]; then
        json_log+=",\"phase\":\"$phase\""
    fi
    
    if [[ -n "$selection_reason" ]]; then
        json_log+=",\"selection_reason\":\"$selection_reason\""
    fi
    
    # Add remote context
    json_log+=",\"remote_addr\":\"$remote_addr\""
    json_log+=",\"tailscale\":$tailscale"
    json_log+=",\"allowed\":true"
    json_log+=",\"body_size_kb\":$body_size_kb"
    
    json_log+="}"
    
    if [[ "$JSON_MODE" == "true" ]]; then
        echo "$json_log"
    fi
}

# Function to estimate tokens from text
estimate_tokens() {
    local text="$1"
    # Rough estimation: ~4 characters per token
    echo $(( (${#text} + 3) / 4 ))
}

# Function to extract model size from model name
get_model_size() {
    local model="$1"
    case "$model" in
        *"8b"*|*"8B"*) echo "8B" ;;
        *"32b"*|*"32B"*) echo "32B" ;;
        *"70b"*|*"70B"*) echo "70B" ;;
        *) echo "unknown" ;;
    esac
}

# Function to resolve ollama path using Python resolver
resolve_ollama() {
    # First check if OLLAMA_BIN is set
    if [[ -n "${OLLAMA_BIN:-}" ]] && [[ -x "$OLLAMA_BIN" ]]; then
        echo "$OLLAMA_BIN"
        return 0
    fi
    
    # Fallback to Python resolver
    local bridge_dir="$(dirname "$0")/../bridge"
    if [[ -f "$bridge_dir/resolve.py" ]]; then
        python3 -c "
import sys
sys.path.insert(0, '$bridge_dir')
from resolve import resolve_ollama_path
path, tried = resolve_ollama_path()
if path:
    print(path)
    sys.exit(0)
else:
    print('NOT_FOUND', file=sys.stderr)
    sys.exit(1)
" 2>/dev/null || echo ""
    else
        # Final fallback - try which
        which ollama 2>/dev/null || echo ""
    fi
}

# Function to select local model based on preferences and content
select_local_model() {
    local text="$1"
    local token_count=$(estimate_tokens "$text")
    
    # Define model mappings
    local model_8b="llama3.1:8b-instruct-q5_K_M"
    local model_32b="qwen2.5:32b-instruct-q4_K_M"
    local model_70b="llama3.1:70b-instruct-q4_K_M"
    
    # Check environment override first
    case "${LOCAL_MODEL_PREF}" in
        8b)
            echo "$model_8b" "env:LOCAL_MODEL_PREF=8b"
            return
            ;;
        32b)
            echo "$model_32b" "env:LOCAL_MODEL_PREF=32b"
            return
            ;;
        70b)
            echo "$model_70b" "env:LOCAL_MODEL_PREF=70b"
            return
            ;;
        auto)
            # Continue to auto selection logic
            ;;
        *)
            # Treat invalid values as auto
            log "Warning: Invalid LOCAL_MODEL_PREF='${LOCAL_MODEL_PREF}', using auto"
            ;;
    esac
    
    # Auto selection logic
    # Check for keywords that bump to 70B
    local keywords="chain-of-thought|theorem|proof|formal spec|complex plan|optimize algorithm|write compiler|multi-agent orchestration|mathematical proof"
    if [[ "$text" =~ $keywords ]]; then
        # Extract the matched keyword for logging
        local matched_keyword=""
        if [[ "$text" =~ chain-of-thought ]]; then matched_keyword="chain-of-thought"
        elif [[ "$text" =~ theorem ]]; then matched_keyword="theorem"
        elif [[ "$text" =~ proof ]]; then matched_keyword="proof"
        elif [[ "$text" =~ "formal spec" ]]; then matched_keyword="formal spec"
        elif [[ "$text" =~ "complex plan" ]]; then matched_keyword="complex plan"
        elif [[ "$text" =~ "optimize algorithm" ]]; then matched_keyword="optimize algorithm"
        elif [[ "$text" =~ "write compiler" ]]; then matched_keyword="write compiler"
        elif [[ "$text" =~ "multi-agent orchestration" ]]; then matched_keyword="multi-agent orchestration"
        elif [[ "$text" =~ "mathematical proof" ]]; then matched_keyword="mathematical proof"
        fi
        
        echo "$model_70b" "keyword:$matched_keyword"
        return
    fi
    
    # Token-based selection
    if [[ $token_count -le 300 ]]; then
        echo "$model_8b" "length<=${token_count}:8b"
    elif [[ $token_count -le 1200 ]]; then
        echo "$model_32b" "length=${token_count}:32b"
    else
        echo "$model_70b" "length>${token_count}:70b"
    fi
}

# Function to show spinner for network operations
show_spinner() {
    local message="$1"
    local pid="$2"
    
    if [[ "$QUIET_MODE" == "true" || "$JSON_MODE" == "true" ]]; then
        return
    fi
    
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0
    
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r%s %c" "$message" "${spin:$i++%${#spin}:1}"
        sleep 0.1
    done
    printf "\r%*s\r" $((${#message} + 2)) ""
}

# Function to check dependencies with actionable error messages
check_dependencies() {
    local missing_deps=()
    local error_messages=()
    
    # Resolve ollama path
    local ollama_cmd
    ollama_cmd=$(resolve_ollama)
    
    if [[ -z "$ollama_cmd" ]]; then
        missing_deps+=("ollama")
        error_messages+=("Missing ollama CLI tool. Install via: brew install ollama")
        error_messages+=("Or set OLLAMA_BIN environment variable to the full path")
    elif ! "$ollama_cmd" list >/dev/null 2>&1; then
        error_messages+=("Ollama service unavailable. Start with: $ollama_cmd serve")
        exit 2
    fi
    
    
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        log "Error: Missing required dependencies: ${missing_deps[*]}"
        for msg in "${error_messages[@]}"; do
            log "  → $msg"
        done
        exit 1
    fi
    
    # Check if models are available (only if ollama is found)
    if [[ -n "$ollama_cmd" ]] && ! "$ollama_cmd" list | grep -q "$OLLAMA_MODEL" >/dev/null 2>&1; then
        log "Warning: Primary model $OLLAMA_MODEL not found. Will attempt fallback."
        log "  → To install: $ollama_cmd pull $OLLAMA_MODEL"
    fi
}

# Function to get input text
get_input_text() {
    if [[ $# -gt 0 ]]; then
        echo "$*"
    else
        cat
    fi
}

# Function to classify text using TinyIntent
classify_text() {
    local text="$1"
    
    if [[ ! -x "$TINYINTENT_BIN" ]]; then
        log "Error: TinyIntent binary not found or not executable: $TINYINTENT_BIN"
        exit 1
    fi
    
    local route
    if ! route=$(echo "$text" | "$TINYINTENT_BIN" 2>/dev/null); then
        log "Error: Failed to classify text with TinyIntent"
        exit 1
    fi
    
    echo "$route"
}

# Function to execute Ollama with fallback
execute_ollama() {
    local text="$1"
    local model="$2"
    local reclassified="${3:-false}"
    local start_time end_time duration_ms
    
    # Resolve ollama command
    local ollama_cmd
    ollama_cmd=$(resolve_ollama)
    
    if [[ -z "$ollama_cmd" ]]; then
        log "Error: ollama command not found"
        return 1
    fi
    
    log "Routing to Ollama with model: $model"
    
    if [[ "$DRY_RUN" == "true" ]]; then
        log "Would execute: echo '$text' | $ollama_cmd run '$model'"
        log "exec: ollama run $model"  # For test assertions
        
        # Emit dry run JSON log
        local tokens_in=$(estimate_tokens "$text")
        local tokens_out=50  # Estimated for dry run
        local model_size=$(get_model_size "$model")
        
        # Human-readable feedback to stderr
        log "route=local_only model=$model tokens_in=$tokens_in tokens_out=$tokens_out latency_ms=0 privacy=local_only"
        
        # JSON log to stdout
        emit_json_log "local_only" "$model" "$model_size" "$tokens_in" "$tokens_out" "0" "local_only" "$reclassified"
        
        return 0
    fi
    
    start_time=$(date +%s%N)
    
    # Start ollama in background for spinner
    local temp_file=$(mktemp)
    (
        echo "$text" | "$ollama_cmd" run "$model" > "$temp_file" 2>&1
        echo $? > "$temp_file.exit"
    ) &
    local pid=$!
    
    # Show spinner for network-bound operation (Ollama can be local or remote)
    show_spinner "Running Ollama ($model)" "$pid"
    wait "$pid"
    
    end_time=$(date +%s%N)
    duration_ms=$(( (end_time - start_time) / 1000000 ))
    
    local exit_code=$(cat "$temp_file.exit")
    local output=$(cat "$temp_file")
    
    rm -f "$temp_file" "$temp_file.exit"
    
    if [[ $exit_code -eq 0 ]]; then
        local tokens_in=$(estimate_tokens "$text")
        local tokens_out=$(estimate_tokens "$output")
        local model_size=$(get_model_size "$model")
        
        # Human-readable feedback to stderr
        log "route=local_only model=$model tokens_in=$tokens_in tokens_out=$tokens_out latency_ms=$duration_ms privacy=local_only"
        
        # JSON log to stdout
        emit_json_log "local_only" "$model" "$model_size" "$tokens_in" "$tokens_out" "$duration_ms" "local_only" "$reclassified"
        
        # Output the response
        echo "$output"
        return 0
    else
        log "Failed to run Ollama with model: $model"
        log "  → Error: $output"
        return 1
    fi
}

