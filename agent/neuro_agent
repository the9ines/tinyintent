#!/usr/bin/env bash

# TinyIntent Neuro Agent - Routes prompts to appropriate backends
# Usage: neuro_agent [--dry-run] [text...]

set -euo pipefail
IFS=$'\n\t'

# Environment variables with defaults
TINYINTENT_BIN="${TINYINTENT_BIN:-/Users/oberfelder/projects/smallintent/router/tinyintent}"
OLLAMA_MODEL="${OLLAMA_MODEL:-qwen2.5:32b-instruct-q4_K_M}"
CLAUDE_CLI_MODEL="${CLAUDE_CLI_MODEL:-claude-3-sonnet-20240229}"

# Global flags
DRY_RUN=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        *)
            break
            ;;
    esac
done

# Function to log to stderr
log() {
    echo "$@" >&2
}

# Function to check dependencies
check_dependencies() {
    local missing_deps=()
    
    if ! command -v ollama >/dev/null 2>&1; then
        missing_deps+=("ollama")
    fi
    
    if ! command -v claude >/dev/null 2>&1; then
        missing_deps+=("claude")
    fi
    
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        log "Error: Missing required dependencies: ${missing_deps[*]}"
        log "Please install the missing tools and try again."
        exit 1
    fi
}

# Function to get input text
get_input_text() {
    if [[ $# -gt 0 ]]; then
        echo "$*"
    else
        cat
    fi
}

# Function to classify text using TinyIntent
classify_text() {
    local text="$1"
    
    if [[ ! -x "$TINYINTENT_BIN" ]]; then
        log "Error: TinyIntent binary not found or not executable: $TINYINTENT_BIN"
        exit 1
    fi
    
    local route
    if ! route=$(echo "$text" | "$TINYINTENT_BIN" 2>/dev/null); then
        log "Error: Failed to classify text with TinyIntent"
        exit 1
    fi
    
    echo "$route"
}

# Function to execute Ollama with fallback
execute_ollama() {
    local text="$1"
    local model="$2"
    
    log "Routing to Ollama with model: $model"
    
    if [[ "$DRY_RUN" == "true" ]]; then
        log "Would execute: echo '$text' | ollama run '$model'"
        return 0
    fi
    
    if echo "$text" | ollama run "$model" 2>/dev/null; then
        return 0
    else
        log "Failed to run Ollama with model: $model"
        return 1
    fi
}

# Function to execute Ollama with fallback chain
execute_ollama_with_fallback() {
    local text="$1"
    
    # Try primary model first
    if execute_ollama "$text" "$OLLAMA_MODEL"; then
        return 0
    fi
    
    # Try fallback model
    local fallback_model="llama3.1:8b-instruct-q5_K_M"
    log "Falling back to: $fallback_model"
    
    if execute_ollama "$text" "$fallback_model"; then
        return 0
    fi
    
    log "Error: All Ollama models failed"
    exit 2
}

# Function to execute Claude CLI
execute_claude() {
    local text="$1"
    
    log "Routing to Claude CLI with model: $CLAUDE_CLI_MODEL"
    
    if [[ "$DRY_RUN" == "true" ]]; then
        log "Would execute: echo '$text' | claude --permission-mode plan --model '$CLAUDE_CLI_MODEL'"
        return 0
    fi
    
    if echo "$text" | claude --permission-mode plan --model "$CLAUDE_CLI_MODEL" 2>/dev/null; then
        return 0
    else
        log "Error: Claude CLI execution failed"
        exit 1
    fi
}

# Function to execute plan_then_claude workflow
execute_plan_then_claude() {
    local text="$1"
    
    log "Routing to plan_then_claude: Ollama -> Claude pipeline"
    
    if [[ "$DRY_RUN" == "true" ]]; then
        log "Would execute: echo '$text' | ollama run '$OLLAMA_MODEL' | claude --permission-mode plan --model '$CLAUDE_CLI_MODEL'"
        return 0
    fi
    
    # First pass through Ollama for planning/refinement
    local refined_text
    if ! refined_text=$(echo "$text" | ollama run "$OLLAMA_MODEL" 2>/dev/null); then
        log "Error: Ollama planning phase failed"
        # Fallback to direct Claude
        log "Falling back to direct Claude execution"
        execute_claude "$text"
        return $?
    fi
    
    # Second pass through Claude with refined text
    if echo "$refined_text" | claude --permission-mode plan --model "$CLAUDE_CLI_MODEL" 2>/dev/null; then
        return 0
    else
        log "Error: Claude execution in pipeline failed"
        exit 1
    fi
}

# Main execution function
main() {
    # Only check dependencies when not in dry-run mode
    if [[ "$DRY_RUN" != "true" ]]; then
        check_dependencies
    fi
    
    # Get input text
    local input_text
    input_text=$(get_input_text "$@")
    
    if [[ -z "$input_text" ]]; then
        log "Error: No input text provided"
        exit 1
    fi
    
    # Get route (use ROUTE env var if set, otherwise classify)
    local route
    if [[ -n "${ROUTE:-}" ]]; then
        route="$ROUTE"
        log "Using pre-specified route: $route"
    else
        route=$(classify_text "$input_text")
        log "Classified route: $route"
    fi
    
    # Execute based on route
    case "$route" in
        "send_claude")
            execute_claude "$input_text"
            ;;
        "plan_then_claude")
            execute_plan_then_claude "$input_text"
            ;;
        "local_only")
            execute_ollama_with_fallback "$input_text"
            ;;
        *)
            log "Error: Unknown route: $route"
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"