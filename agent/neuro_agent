# Function to execute Ollama with fallback chain using model selector
execute_ollama_with_fallback() {
    local text="$1"
    local reclassified="${2:-false}"
    
    # Resolve ollama command
    local ollama_cmd
    ollama_cmd=$(resolve_ollama)
    
    if [[ -z "$ollama_cmd" ]]; then
        log "Error: ollama command not found"
        return 1
    fi
    
    # Use model selector to get the preferred model and reason
    local model_selection selected_model selection_reason
    model_selection=$(select_local_model "$text")
    selected_model=$(echo "$model_selection" | cut -d' ' -f1)
    selection_reason=$(echo "$model_selection" | cut -d' ' -f2-)
    
    # Define fallback order: 70B -> 32B -> 8B
    local model_70b="llama3.1:70b-instruct-q4_K_M"
    local model_32b="qwen2.5:32b-instruct-q4_K_M"
    local model_8b="llama3.1:8b-instruct-q5_K_M"
    
    local fallback_models=()
    local current_reason="$selection_reason"
    
    # Build fallback sequence starting from selected model
    case "$selected_model" in
        "$model_70b")
            fallback_models=("$model_70b" "$model_32b" "$model_8b")
            ;;
        "$model_32b")
            fallback_models=("$model_32b" "$model_8b")
            ;;
        "$model_8b")
            fallback_models=("$model_8b")
            ;;
    esac
    
    # Try each model in the fallback sequence
    local tried_models=()
    for model in "${fallback_models[@]}"; do
        log "Attempting model: $model (reason: $current_reason)"
        
        if execute_ollama_with_selection "$text" "$model" "$current_reason" "$reclassified"; then
            return 0
        fi
        
        tried_models+=("$model")
        
        # Update reason for fallback
        local from_size=$(get_model_size "$model")
        local next_model=""
        if [[ "$model" == "$model_70b" ]]; then
            next_model="$model_32b"
            current_reason="fallback:70b->32b:load_error"
        elif [[ "$model" == "$model_32b" ]]; then
            next_model="$model_8b" 
            current_reason="fallback:32b->8b:load_error"
        fi
        
        if [[ -n "$next_model" ]]; then
            log "Model $model failed, falling back to: $next_model"
            log "  → Reason: Model unavailable or load error"
        fi
    done
    
    log "Error: All Ollama models failed (tried: ${tried_models[*]})"
    log "  → Try: $ollama_cmd pull ${fallback_models[0]}"
    log "  → Or: $ollama_cmd serve (if service is down)"
    exit 2
}


# Function to execute plan_then_local workflow
execute_plan_then_local() {
    local text="$1"
    local reclassified="${2:-false}"
    local start_time end_time duration_ms
    
    # Resolve ollama command
    local ollama_cmd
    ollama_cmd=$(resolve_ollama)
    
    if [[ -z "$ollama_cmd" ]]; then
        log "Error: ollama command not found"
        return 1
    fi
    
    log "Routing to plan_then_local: Local refinement → Local execution with larger model"
    
    if [[ "$DRY_RUN" == "true" ]]; then
        # Use model selector for local phase
        local model_selection selected_model selection_reason
        model_selection=$(select_local_model "$text")
        selected_model=$(echo "$model_selection" | cut -d' ' -f1)
        selection_reason=$(echo "$model_selection" | cut -d' ' -f2-)
        
        # For plan_then_local, we use 70B for final execution
        local final_model="llama3.1:70b-instruct-q4_K_M"
        
        log "Would execute: echo '$text' | $ollama_cmd run '$selected_model' | $ollama_cmd run '$final_model'"
        log "exec: ollama run $selected_model"  # For test assertions
        log "exec: ollama run $final_model"
        
        # Emit dry run JSON logs for both phases
        local tokens_in=$(estimate_tokens "$text")
        local tokens_out_1=60  # Estimated for phase 1
        local tokens_out_2=100  # Estimated for phase 2
        local model_size=$(get_model_size "$selected_model")
        local final_model_size=$(get_model_size "$final_model")
        
        # Phase 1: Local refinement
        local remote_info="${REMOTE_ADDR:-local}"
        log "Phase 1: model=$selected_model model_size=$model_size tokens_in=$tokens_in tokens_out=$tokens_out_1 latency_ms=0 reason=$selection_reason remote=$remote_info"
        emit_json_log "plan_then_local" "$selected_model" "$model_size" "$tokens_in" "$tokens_out_1" "0" "local_only" "$reclassified" "refine_local" "$selection_reason"
        
        # Phase 2: Local execution with larger model
        local remote_info="${REMOTE_ADDR:-local}"
        log "route=plan_then_local model=$final_model tokens_in=$tokens_out_1 tokens_out=$tokens_out_2 latency_ms=0 privacy=local_only remote=$remote_info"
        emit_json_log "plan_then_local" "$final_model" "$final_model_size" "$tokens_out_1" "$tokens_out_2" "0" "local_only" "$reclassified" "local_final"
        
        return 0
    fi
    
    # Phase 1: Local refinement with selected model
    local model_selection selected_model selection_reason
    model_selection=$(select_local_model "$text")
    selected_model=$(echo "$model_selection" | cut -d' ' -f1)
    selection_reason=$(echo "$model_selection" | cut -d' ' -f2-)
    
    log "Phase 1: Local refinement with $selected_model (reason: $selection_reason)"
    start_time=$(date +%s%N)
    
    local temp_file=$(mktemp)
    (
        echo "$text" | "$ollama_cmd" run "$selected_model" > "$temp_file" 2>&1
        echo $? > "$temp_file.exit"
    ) &
    local pid=$!
    
    show_spinner "Refining locally ($selected_model)" "$pid"
    wait "$pid"
    
    end_time=$(date +%s%N)
    duration_ms=$(( (end_time - start_time) / 1000000 ))
    
    local exit_code=$(cat "$temp_file.exit")
    local refined_text=$(cat "$temp_file")
    
    rm -f "$temp_file" "$temp_file.exit"
    
    if [[ $exit_code -ne 0 ]]; then
        log "Error: Ollama planning phase failed"
        log "Falling back to direct local execution"
        execute_ollama_with_fallback "$text" "$reclassified"
        return $?
    fi
    
    # Log Phase 1 completion
    local tokens_in_1=$(estimate_tokens "$text")
    local tokens_out_1=$(estimate_tokens "$refined_text")
    local model_size_1=$(get_model_size "$selected_model")
    
    local remote_info="${REMOTE_ADDR:-local}"
    log "Phase 1 complete: model=$selected_model model_size=$model_size_1 tokens_in=$tokens_in_1 tokens_out=$tokens_out_1 latency_ms=$duration_ms reason=$selection_reason remote=$remote_info"
    emit_json_log "plan_then_local" "$selected_model" "$model_size_1" "$tokens_in_1" "$tokens_out_1" "$duration_ms" "local_only" "$reclassified" "refine_local" "$selection_reason"
    
    # Phase 2: Local execution with larger model (70B)
    local final_model="llama3.1:70b-instruct-q4_K_M"
    log "Phase 2: Local execution with $final_model"
    start_time=$(date +%s%N)
    
    temp_file=$(mktemp)
    (
        echo "$refined_text" | "$ollama_cmd" run "$final_model" > "$temp_file" 2>&1
        echo $? > "$temp_file.exit"
    ) &
    pid=$!
    
    show_spinner "Executing locally ($final_model)" "$pid"
    wait "$pid"
    
    end_time=$(date +%s%N)
    duration_ms=$(( (end_time - start_time) / 1000000 ))
    
    exit_code=$(cat "$temp_file.exit")
    local final_output=$(cat "$temp_file")
    
    rm -f "$temp_file" "$temp_file.exit"
    
    if [[ $exit_code -eq 0 ]]; then
        local tokens_in_2=$(estimate_tokens "$refined_text")
        local tokens_out_2=$(estimate_tokens "$final_output")
        local final_model_size=$(get_model_size "$final_model")
        
        # Human-readable feedback for final phase
        local remote_info="${REMOTE_ADDR:-local}"
        log "route=plan_then_local model=$final_model tokens_in=$tokens_in_2 tokens_out=$tokens_out_2 latency_ms=$duration_ms privacy=local_only remote=$remote_info"
        
        # JSON log for Phase 2
        emit_json_log "plan_then_local" "$final_model" "$final_model_size" "$tokens_in_2" "$tokens_out_2" "$duration_ms" "local_only" "$reclassified" "local_final"
        
        # Output the final response
        echo "$final_output"
        return 0
    else
        log "Error: Local execution in pipeline failed"
        log "Falling back to direct local execution"
        execute_ollama_with_fallback "$text" "$reclassified"
        return $?
    fi
}

# Main execution function
main() {
    # Only check dependencies when not in dry-run mode
    if [[ "$DRY_RUN" != "true" ]]; then
        check_dependencies
    fi
    
    # Get input text
    local input_text
    input_text=$(get_input_text "$@")
    
    if [[ -z "$input_text" ]]; then
        log "Error: No input text provided"
        exit 1
    fi
    
    # Get route (use ROUTE env var if set, otherwise classify)
    local route
    local reclassified=false
    if [[ -n "${ROUTE:-}" ]]; then
        route="$ROUTE"
        log "Using pre-specified route: $route"
        reclassified=true
    elif [[ "$DRY_RUN" == "true" ]]; then
        # In dry run mode, use a default route if not specified  
        route="local_only"
        log "Dry run mode: using default route: $route"
    else
        route=$(classify_text "$input_text")
        log "Classified route: $route"
    fi
    
    # Execute based on route
    case "$route" in
        "plan_then_local")
            execute_plan_then_local "$input_text" "$reclassified"
            ;;
        "local_only")
            execute_ollama_with_fallback "$input_text" "$reclassified"
            ;;
        *)
            log "Error: Unknown route: $route"
            log "  → Valid routes: local_only, plan_then_local"
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"